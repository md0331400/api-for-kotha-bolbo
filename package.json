{
  "name": "kotha-bolbo-storage-api",
  "version": "1.0.0",
  "private": true,
  "description": "Kotha Bolbo Storage API and private admin dashboard (Firebase Auth + multi-account Google Drive storage pool)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
