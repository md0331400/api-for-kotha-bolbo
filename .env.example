# =============================================================================
# Kotha Bolbo Storage API + Admin — environment variables
# Copy to .env (local dev) or set in Vercel Project Settings → Environment
# Variables (Production / Preview / Development). Leave values EMPTY in Git.
# NEVER commit real values. NEVER prefix private credentials with NEXT_PUBLIC_.
# =============================================================================

# ---- Public app origin (used for OAuth redirects and default CORS) ----------
APP_BASE_URL=https://swkf.vercel.app

# Comma-separated list of additional browser origins allowed to call the API.
# The Android APK is not affected by CORS. Example: https://kothabolbo.app
CORS_ORIGINS=

# ---- Firebase web configuration (public, client-safe) ----------------------
# Used by the admin login page. These values identify the project; they are not
# secrets, but Security Rules and server authorization remain mandatory.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=kotha-bolbo-aso
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Firebase Admin SDK (SERVER ONLY — never expose to any client) ---------
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Secrets (SERVER ONLY) -------------------------------------------------
# HMAC key (min 32 chars) for OAuth state cookies and signed download tickets.
# NOT a client API key — client keys are generated in Admin → API Keys and only
# their SHA-256 hashes are stored. This value must never reach a browser/app.
API_SECRET_KEY=

# Optional: AES-256-GCM key (64 hex chars) used to encrypt stored Google OAuth
# refresh tokens at rest. Strongly recommended in production.
CREDENTIALS_ENCRYPTION_KEY=

# Shared secret protecting the scheduled cleanup endpoint (Vercel Cron sends
# "Authorization: Bearer <CRON_SECRET>" automatically when this is set).
CRON_SECRET=

# ---- Google OAuth (Google Drive storage pool connection) -------------------
# Google Cloud Console OAuth 2.0 Client (Web application).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated OAuth scopes. Defaults to the minimal Drive app-file scope
# plus email/profile for account identification.
GOOGLE_OAUTH_SCOPES=

# ---- Storage policy --------------------------------------------------------
# Default per-user quota: 2 GiB = 2147483648 bytes
DEFAULT_USER_QUOTA_BYTES=2147483648
# Maximum accepted size of a single upload (bytes). Default 512 MiB.
MAX_UPLOAD_BYTES=536870912
# File retention before automatic deletion (days). Fixed at 60 per product spec.
FILE_TTL_DAYS=60
# Notify this many days before expiry (comma separated). Needs FCM configured.
NOTIFY_EXPIRY_DAYS=7,3
# Upload ticket lifetime (minutes) — the resumable Drive session is short-lived.
UPLOAD_TICKET_TTL_MINUTES=60
# Optional explicit admin bootstrap: comma-separated emails granted admin once.
ADMIN_EMAILS=

# ---- App version defaults (used until an administrator publishes a version) -
APP_VERSION=1.0.0
